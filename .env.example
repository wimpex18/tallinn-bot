# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Mistral AI API key (get from https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=your_mistral_api_key_here

# Bot username without @ (e.g., tallinn_helper_bot)
BOT_USERNAME=your_bot_username_here

# Redis connection string for persistent memory (facts, style profiles, recent
# messages). Recommended: Render Key Value (same platform, free 25MB tier) or
# Upstash (free 256MB / 500K commands per month). See README for setup.
REDIS_URL=redis://user:password@host:port

# For Render webhook deployment only:
# RENDER=true
# WEBHOOK_URL=https://your-app-name.onrender.com
# WEBHOOK_PATH=<random UUID, e.g. `python -c "import uuid; print(uuid.uuid4())"`>
# WEBHOOK_SECRET=<random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`>
